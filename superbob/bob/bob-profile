#!/usr/bin/env bash
# Swap which skills Bob loads, to keep context small.
# Full library lives in ~/.bob/skills-vault (Bob does NOT read it).
# Only the active profile is copied into ~/.bob/skills (Bob DOES read it).
set -euo pipefail

VAULT="$HOME/.bob/skills-vault"
ACTIVE="$HOME/.bob/skills"
PROF="$HOME/.bob/profiles"

# --- Ownership boundary ------------------------------------------------------
# A skill in $ACTIVE is "SuperBob-owned" only if the vault has a skill by that
# name. Anything else in $ACTIVE is the user's OWN skill — never remove it on a
# mode switch. sync_active reconciles $ACTIVE to a staging dir that holds exactly
# the wanted skills: it deletes only owned-and-unwanted skills, adds/refreshes
# the wanted ones, and leaves every external skill exactly where it is.
sync_active() {
  local STAGE="$1"
  mkdir -p "$ACTIVE"
  for d in "$ACTIVE"/*/; do
    [ -d "$d" ] || continue
    local name; name=$(basename "$d")
    if [ -d "$VAULT/$name" ] && [ ! -d "$STAGE/$name" ]; then rm -rf "$d"; fi
  done
  for d in "$STAGE"/*/; do
    [ -d "$d" ] || continue
    local name; name=$(basename "$d")
    rm -rf "$ACTIVE/$name"; cp -R "$d" "$ACTIVE/$name"
  done
}

usage() {
  echo "Usage: bob-profile <name> [name2 ...]   load profile(s)"
  echo "       bob-profile list                 show profiles"
  echo "       bob-profile status               show what's loaded now"
  echo "       bob-profile all                  load ALL skills (heavy: ~67k tokens)"
  echo ""
  echo "Available:"
  for f in "$PROF"/*.txt; do
    n=$(basename "$f" .txt); [ "$n" = "_core" ] && continue
    echo "  $n ($(grep -cve '^[[:space:]]*$' "$f") skills)"
  done
}

cost() {  # rough token estimate of what's loaded
  python3 - "$ACTIVE" << 'PY'
import sys,os,re,glob
tot=0;n=0
for f in glob.glob(os.path.join(sys.argv[1],'*','SKILL.md')):
    try:t=open(f,encoding='utf-8',errors='ignore').read()
    except:continue
    m=re.match(r'^---\s*\n(.*?)\n---',t,re.S)
    if m: tot+=len(m.group(1)); n+=1
print(f"  {n} skills loaded  ~= {tot//4:,} tokens of descriptions")
PY
}

[ $# -eq 0 ] && { usage; exit 1; }

case "${1:-}" in
  list) usage; exit 0 ;;
  status)
    echo "Currently loaded in ~/.bob/skills:"; cost
    [ -f "$ACTIVE/.profile" ] && echo "  profile: $(cat "$ACTIVE/.profile")" || echo "  profile: (unknown)"
    exit 0 ;;
  all)
    mkdir -p "$ACTIVE"
    rsync -a "$VAULT"/ "$ACTIVE"/          # add/refresh every vault skill; no --delete, so external skills stay
    echo "all" > "$ACTIVE/.profile"
    echo "Loaded ALL skills (your own skills kept)."; cost; exit 0 ;;
  lean|core)
    TMP=$(mktemp -d)
    while read -r s; do [ -z "$s" ] && continue; [ -d "$VAULT/$s" ] && cp -R "$VAULT/$s" "$TMP/$s"; done < "$PROF/_core.txt"
    sync_active "$TMP"; rm -rf "$TMP"
    echo "lean (core only)" > "$ACTIVE/.profile"
    echo "Loaded lean core — mission-control routes the rest from the vault on demand."; cost; exit 0 ;;
esac

# Resolve each requested name to a profile file. Mode files carry a `super-` prefix,
# but accept the bare name too ("code" -> "super-code"). Validate BEFORE touching anything.
RESOLVED=()
for p in "$@"; do
  if   [ -f "$PROF/$p.txt" ];       then RESOLVED+=("$p")
  elif [ -f "$PROF/super-$p.txt" ]; then RESOLVED+=("super-$p")
  else echo "ERROR: no profile '$p'"; echo; usage; exit 1; fi
done
set -- "${RESOLVED[@]}"

TMP=$(mktemp -d)
copy_list() {
  while read -r s; do
    [ -z "$s" ] && continue
    if [ -d "$VAULT/$s" ]; then cp -R "$VAULT/$s" "$TMP/$s" 2>/dev/null || true
    else echo "  warn: '$s' not in vault (skipped)" >&2; fi
  done < "$1"
}
copy_list "$PROF/_core.txt"          # core always
for p in "$@"; do copy_list "$PROF/$p.txt"; done

COUNT=$(ls -1 "$TMP" | wc -l | tr -d ' ')
[ "$COUNT" -lt 2 ] && { echo "ERROR: only $COUNT skills resolved — aborting, nothing changed."; rm -rf "$TMP"; exit 1; }

sync_active "$TMP"; rm -rf "$TMP"
echo "core + $*" > "$ACTIVE/.profile"

echo "Loaded: core + $* (your own skills kept)"
cost
echo ""
echo "Restart your Bob conversation for the change to take effect."
