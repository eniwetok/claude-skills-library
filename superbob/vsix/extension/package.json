{
  "name": "super-bob-skills",
  "displayName": "Super-bob-skills",
  "description": "SuperBob gives Bob a library of expert skills and loads the right ones for the task you're on, grouped into kits for each kind of work (coding, testing, review, security, product, and more), so Bob brings focused expertise instead of generic help.",
  "version": "1.58.0",
  "publisher": "felipe-campo",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "skills",
    "best practices",
    "agent",
    "bob",
    "productivity"
  ],
  "activationEvents": [
    "onView:superbob.panel",
    "onCommand:superBobSkills.openPanel",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superbobContainer",
          "title": "SuperBob",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "superbobContainer": [
        {
          "id": "superbob.panel",
          "name": "Skills",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "superBobSkills.openPanel",
        "title": "SuperBob: Open Control Panel",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.install",
        "title": "SuperBob: Install / Update Skills",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.loadProfile",
        "title": "SuperBob: Load Kit\u2026",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.status",
        "title": "SuperBob: Show Active Kit",
        "category": "SuperBob"
      }
    ]
  },
  "galleryBanner": {
    "color": "#2b2fdb",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
