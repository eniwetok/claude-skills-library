        <mxCell id="kitmap1_h" value="How to use SuperBob in this stage — the kit to load at each step (blank = Bob or Propel handles it, no SuperBob kit needed).  Blue = SuperBob kit, teal = Propel." style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="kitmap1"><mxGeometry x="-794" y="1600" width="968" height="30" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r0" value="&lt;b&gt;Step 1 — PM Feature Brief&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-management&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to refine the capability and its intent&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-frameworks&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to frame it as a job-to-be-done / opportunity&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#0e8088&quot;&gt;Propel: Jira Skill&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to update the capability in Jira&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1636" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r1" value="&lt;b&gt;Step 2 — Create Epic&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-management&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to write the epic&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#0e8088&quot;&gt;Propel: Product Epic Template&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to fill the epic template&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#0e8088&quot;&gt;Propel: Jira Skill&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to upload the epic to Jira&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1680" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r2" value="&lt;b&gt;Step 3 — Refine Epic&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-management&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to sharpen the epic with the team&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1724" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r3" value="&lt;b&gt;Step 4 — Create spec (Bob)&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;content-writing&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to tighten the spec prose Bob drafts&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;diagramming&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to sketch the screens / flows the spec describes&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1768" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r4" value="&lt;b&gt;Step 5 — Clarify Bob questions&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;web-research&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to research answers to the open questions&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1812" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r5" value="&lt;b&gt;Step 6 — Push Spec to repo&lt;/b&gt; &amp;#8212; &lt;font color=&quot;#999&quot;&gt;handled by Bob / Propel — no SuperBob kit needed&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1856" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r6" value="&lt;b&gt;Step 7 — Final PR Approval&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;release-review&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to run the pre-ship review&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-management&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to confirm business intent is preserved&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1900" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_r7" value="&lt;b&gt;Step 8 — Create stories in Jira&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#0e8088&quot;&gt;Propel: Jira Skill&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to create the stories in Jira&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1944" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap1_ver" value="SuperBob kits mapping &#183; v1.82.0 &#183; 2026-08-12" style="text;html=1;fontSize=10;fontColor=#9aa0a6;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="kitmap1"><mxGeometry x="-798" y="1994" width="976" height="16" as="geometry"/></mxCell>
      </root>
