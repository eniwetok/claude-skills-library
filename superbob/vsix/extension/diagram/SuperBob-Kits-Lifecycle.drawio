        <mxCell id="kitmap10" value="How to use SuperBob" style="locked=0;" parent="0" />
        <mxCell id="kitmap10_bg" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;opacity=80;" vertex="1" parent="kitmap10"><mxGeometry x="2" y="1070" width="1000" height="388" as="geometry"/></mxCell>
        <mxCell id="kitmap10_h" value="How to use SuperBob in this stage — the kit to load at each step (blank = Bob or Propel handles it, no SuperBob kit needed).  Blue = SuperBob kit, teal = Propel." style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="kitmap10"><mxGeometry x="18" y="1078" width="968" height="30" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r0" value="&lt;b&gt;Step 1 — Create automated tests (Bob)&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to author the automated tests&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1114" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r1" value="&lt;b&gt;Step 2 — QA Reviews Automated Tests&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to validate the automation&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1158" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r2" value="&lt;b&gt;Step 4 — Run automated tests&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to run the functional suite&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;application-security&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to run the security / pen tests&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1202" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r3" value="&lt;b&gt;Step 5 — QA Reviews Test Reports&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to read the results&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;release-review&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to make the ship / no-ship call&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1246" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r4" value="&lt;b&gt;Step 6 — Developer fixes issues&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;bug-fixing&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to fix the failures found&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1290" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r5" value="&lt;b&gt;Step 7 — Rerun test cases&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to re-run to confirm green&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1334" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_r6" value="&lt;b&gt;Step 7 — Update results in Test Rail&lt;/b&gt; &amp;#8212; &lt;font color=&quot;#999&quot;&gt;handled by Bob / Propel — no SuperBob kit needed&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1378" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap10_ver" value="SuperBob kits mapping &#183; v1.82.0 &#183; 2026-08-12" style="text;html=1;fontSize=10;fontColor=#9aa0a6;align=right;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="kitmap10"><mxGeometry x="14" y="1428" width="976" height="16" as="geometry"/></mxCell>
