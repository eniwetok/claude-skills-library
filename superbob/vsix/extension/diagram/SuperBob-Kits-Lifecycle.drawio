<diagram name="Overview — Phases" id="ov-phases"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Spec-Driven Development — End-to-End Phases" style="text;html=1;fontStyle=1;fontSize=20;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1620" height="32" as="geometry"/></mxCell><mxCell id="ts" value="Input → five phases → shipped feature. Each phase output feeds the next. Colour = phase." style="text;html=1;fontSize=13;fontColor=#666;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1620" height="22" as="geometry"/></mxCell><mxCell id="in" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;Jira Capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="188" width="120" height="60" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;Phase 1 — Spec Creation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Turn a PM brief into a unified, dev + QA-approved spec via Bob interrogation.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#8594; Final Approved Spec&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="220" height="155" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="in" target="p0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;&lt;font color=&quot;#82b366&quot;&gt;Phase 2 — Implementation Planning&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bob drafts the implementation plan; dev reviews; work is broken into Jira tasks.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#8594; Tasks in Jira&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="220" height="155" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;&lt;font color=&quot;#d79b00&quot;&gt;Phase 2.1 — QA Planning&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;QA agent drafts test plans &amp; cases; QA reviews; uploaded to TestRail.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#8594; Test cases in TestRail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="220" height="155" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;Phase 3 — Development&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bob codes test-first; devs review PRs; CI/CD builds for QA.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#8594; Builds for QA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="980" y="140" width="220" height="155" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;Phase 4 — QA Test Execution&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Automated tests authored &amp; run; devs fix failures; results logged.&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;#8594; Ship / no-ship decision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="220" height="155" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Shipped&lt;/b&gt;&lt;br&gt;Feature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="188" width="120" height="60" as="geometry"/></mxCell><mxCell id="eout" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="p4" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ver" value="SuperBob kits mapping &#183; v1.82.0 &#183; 2026-08-12" style="text;html=1;fontSize=10;fontColor=#9aa0a6;align=right;" vertex="1" parent="1"><mxGeometry x="40" y="329" width="1620" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Overview — Tools" id="ov-tools"><mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Tooling Across the Lifecycle — Kits &amp; Tools End to End" style="text;html=1;fontStyle=1;fontSize=20;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1460" height="32" as="geometry"/></mxCell><mxCell id="ts" value="Every SuperBob kit (blue) and Propel tool (teal) a team loads at each phase. Blank = handled by Bob / Propel, no kit needed." style="text;html=1;fontSize=13;fontColor=#666;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1460" height="22" as="geometry"/></mxCell><mxCell id="h0" value="Phase" style="text;html=1;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#c8ccd2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="32" as="geometry"/></mxCell><mxCell id="h1" value="SuperBob kits used" style="text;html=1;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#c8ccd2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="740" height="32" as="geometry"/></mxCell><mxCell id="h2" value="Propel tools used" style="text;html=1;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;fillColor=#eef1f5;strokeColor=#c8ccd2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="480" height="32" as="geometry"/></mxCell><mxCell id="pr0" value="&lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;Phase 1 — Spec Creation&lt;/font&gt;&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e5e7eb;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="240" height="90" as="geometry"/></mxCell><mxCell id="kr0" value="&lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-management&lt;/font&gt;&lt;/b&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;product-frameworks&lt;/font&gt;&lt;/b&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;content-writing&lt;/font&gt;&lt;/b&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;diagramming&lt;/font&gt;&lt;/b&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#6c8ebf