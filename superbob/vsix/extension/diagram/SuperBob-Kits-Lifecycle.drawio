        <mxCell id="kitmap7_bg" value="" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;opacity=80;" vertex="1" parent="kitmap7"><mxGeometry x="-70" y="950" width="1000" height="256" as="geometry"/></mxCell>
        <mxCell id="kitmap7_h" value="How to use SuperBob in this stage — the kit to load at each step (blank = Bob or Propel handles it, no SuperBob kit needed).  Blue = SuperBob kit, teal = Propel." style="text;html=1;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="kitmap7"><mxGeometry x="-54" y="958" width="968" height="30" as="geometry"/></mxCell>
        <mxCell id="kitmap7_r0" value="&lt;b&gt;Step 1 — Bob starts coding (TDD)&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;software-development&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to implement the feature&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;test-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to generate the unit tests (TDD)&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;frontend-design&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to build the UI when the feature has one&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;web-design&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to turn the Figma design into UI code&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap7"><mxGeometry x="-58" y="994" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap7_r1" value="&lt;b&gt;Step 2 — Dev Reviews Code PR&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;bug-fixing&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to catch defects before merge&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;code-simplification&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to cut over-engineering&lt;/font&gt; &amp;#183; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;application-security&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to check the PR for security issues&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap7"><mxGeometry x="-58" y="1038" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap7_r2" value="&lt;b&gt;Step 3 — Update Task Progress in Jira&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#0e8088&quot;&gt;Propel: Jira Skill&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to update task status in Jira&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap7"><mxGeometry x="-58" y="1082" width="976" height="38" as="geometry"/></mxCell>
        <mxCell id="kitmap7_r3" value="&lt;b&gt;Step 3 — Create builds for QA (CICD)&lt;/b&gt; &amp;#8212; &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;production-engineering&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#777&quot;&gt;to CI/CD builds and deploy to test&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#e5e7eb;fillColor=#fafbfc;spacingLeft=8;spacingRight=8;spacingTop=2;" vertex="1" parent="kitmap7"><mxGeometry x="-58" y="1126" width="976" height="38" as="geometry"/></mxCell>
