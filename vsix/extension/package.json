{
  "name": "super-bob-skills",
  "displayName": "Super-bob-skills",
  "description": "Best-practice skills for IBM Bob and VS Code, loaded by task so agent context stays small.",
  "version": "1.2.0",
  "publisher": "felipe-campo",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "skills",
    "best practices",
    "agent",
    "bob",
    "productivity"
  ],
  "activationEvents": [
    "onView:superbob.panel",
    "onCommand:superBobSkills.openPanel",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "superbob.chat",
        "name": "superbob",
        "fullName": "SuperBob",
        "description": "Switch skill modes — try /list, /auto, or /rag",
        "isSticky": true,
        "commands": [
          { "name": "list", "description": "List available modes" },
          { "name": "auto", "description": "Auto mode — SuperBob picks skills per task" },
          { "name": "rag", "description": "Evaluate a RAG / retrieval agent" },
          { "name": "code", "description": "Build software" },
          { "name": "data", "description": "Data & AI evaluation" },
          { "name": "pm", "description": "Product management" },
          { "name": "security", "description": "Security audits & hunting" },
          { "name": "ui", "description": "Interfaces & design" },
          { "name": "research", "description": "Research & notes" },
          { "name": "ship-it", "description": "Quality gate before shipping" },
          { "name": "quick-fix", "description": "Fast debugging" }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superbobContainer",
          "title": "SuperBob",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "superbobContainer": [
        {
          "id": "superbob.panel",
          "name": "Skills",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "superBobSkills.openPanel",
        "title": "SuperBob: Open Control Panel",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.install",
        "title": "SuperBob: Install / Update Skills",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.loadProfile",
        "title": "SuperBob: Load Profile\u2026",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.status",
        "title": "SuperBob: Show Active Profile",
        "category": "SuperBob"
      }
    ],
    "configuration": {
      "title": "SuperBob",
      "properties": {
        "superBobSkills.targets": {
          "type": "string",
          "enum": [
            "both",
            "bob",
            "claude"
          ],
          "default": "both",
          "description": "Where to install skills: IBM Bob (~/.bob/skills), VS Code's agent (~/.claude/skills), or both."
        }
      }
    }
  },
  "galleryBanner": {
    "color": "#2b2fdb",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
