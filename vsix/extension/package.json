{
  "name": "super-bob-skills",
  "displayName": "Super-bob-skills",
  "description": "Best-practice skills for IBM Bob and VS Code, loaded by task so agent context stays small.",
  "version": "1.2.0",
  "publisher": "felipe-campo",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "skills",
    "best practices",
    "agent",
    "bob",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "superBobSkills.install",
        "title": "SuperBob: Install / Update Skills",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.loadProfile",
        "title": "SuperBob: Load Profile\u2026",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.status",
        "title": "SuperBob: Show Active Profile",
        "category": "SuperBob"
      }
    ],
    "configuration": {
      "title": "SuperBob",
      "properties": {
        "superBobSkills.targets": {
          "type": "string",
          "enum": [
            "both",
            "bob",
            "claude"
          ],
          "default": "both",
          "description": "Where to install skills: IBM Bob (~/.bob/skills), VS Code's agent (~/.claude/skills), or both."
        }
      }
    }
  },
  "galleryBanner": {
    "color": "#2b2fdb",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
