{
  "name": "super-bob-skills",
  "displayName": "Super-bob-skills",
  "description": "Help every developer get senior-level results from Bob across the whole software lifecycle. SuperBob puts best-practice, stage-specific skills (design, build, test, secure, review, ship) in front of the agent automatically — so best practices are applied consistently, not left to who remembers to ask.",
  "version": "1.15.0",
  "publisher": "felipe-campo",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "skills",
    "best practices",
    "agent",
    "bob",
    "productivity"
  ],
  "activationEvents": [
    "onView:superbob.panel",
    "onCommand:superBobSkills.openPanel",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superbobContainer",
          "title": "SuperBob",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "superbobContainer": [
        {
          "id": "superbob.panel",
          "name": "Skills",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "superBobSkills.openPanel",
        "title": "SuperBob: Open Control Panel",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.install",
        "title": "SuperBob: Install / Update Skills",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.loadProfile",
        "title": "SuperBob: Load Profile\u2026",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.status",
        "title": "SuperBob: Show Active Profile",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.installCrg",
        "title": "SuperBob: Install code-review-graph (MCP tool)",
        "category": "SuperBob"
      }
    ],
    "configuration": {
      "title": "SuperBob",
      "properties": {
        "superBobSkills.targets": {
          "type": "string",
          "enum": [
            "both",
            "bob",
            "claude"
          ],
          "default": "both",
          "description": "Where to install skills: IBM Bob (~/.bob/skills), VS Code's agent (~/.claude/skills), or both."
        }
      }
    }
  },
  "galleryBanner": {
    "color": "#2b2fdb",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
