{
  "name": "super-bob-skills",
  "displayName": "Super-bob-skills",
  "description": "Help every developer get strong results from Bob across the software lifecycle. SuperBob loads the right skills for each stage (design, build, test, secure, review, ship) automatically, so your best practices get applied consistently instead of only when someone remembers to ask.",
  "version": "1.18.0",
  "publisher": "felipe-campo",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "skills",
    "best practices",
    "agent",
    "bob",
    "productivity"
  ],
  "activationEvents": [
    "onView:superbob.panel",
    "onCommand:superBobSkills.openPanel",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "superbobContainer",
          "title": "SuperBob",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "superbobContainer": [
        {
          "id": "superbob.panel",
          "name": "Skills",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "superBobSkills.openPanel",
        "title": "SuperBob: Open Control Panel",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.install",
        "title": "SuperBob: Install / Update Skills",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.loadProfile",
        "title": "SuperBob: Load Kit\u2026",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.status",
        "title": "SuperBob: Show Active Kit",
        "category": "SuperBob"
      },
      {
        "command": "superBobSkills.installCrg",
        "title": "SuperBob: Install code-review-graph (MCP tool)",
        "category": "SuperBob"
      }
    ],
    "configuration": {
      "title": "SuperBob",
      "properties": {
        "superBobSkills.targets": {
          "type": "string",
          "enum": [
            "both",
            "bob",
            "claude"
          ],
          "default": "both",
          "description": "Where to install skills: IBM Bob (~/.bob/skills), VS Code's agent (~/.claude/skills), or both."
        }
      }
    }
  },
  "galleryBanner": {
    "color": "#2b2fdb",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
